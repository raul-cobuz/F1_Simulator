o ground
v -1000.000000 0.000000 1000.000000
v 1000.000000 0.000000 1000.000000
v 1000.000000 0.000000 -1000.000000
v -1000.000000 0.000000 -1000.000000
vn -0.0000 1.0000 -0.0000
vt 50.000000 -50.000000
vt -50.000000 50.000000
vt -50.000000 -50.000000
vt 50.000000 50.000000
